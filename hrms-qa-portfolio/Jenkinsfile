pipeline {
    agent any
    tools { jdk 'JDK21'; maven 'Maven3' }
    stages {
        stage('Checkout') { steps { checkout scm } }
        stage('Run tests') { steps { sh 'mvn -B clean test -Dheadless=true' } }
        stage('Archive reports') {
            steps { archiveArtifacts artifacts: 'target/surefire-reports/**,target/cucumber-report.html', allowEmptyArchive: true }
        }
    }
    post { always { echo 'Review Surefire and Cucumber reports for failures.' } }
}
